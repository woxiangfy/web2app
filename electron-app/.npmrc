# 国内镜像：electron 二进制（~120MB）与 electron-builder 的 winCodeSign / nsis 等工具包
# 不加这两行，npm install / electron-builder 在墙内极易超时或卡死。
#
# ⚠️ 但这两行**只对 npm 有效**：pnpm 不会把 .npmrc 里的自定义键透传给依赖的 install 脚本
#    （脚本里能看到的 npm_config_* 只有 npm_config_user_agent），而 electron 的 install.js
#    与 electron-builder 的下载器都只认环境变量。用 pnpm 时必须显式设：
#      $env:ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"
#      $env:ELECTRON_BUILDER_BINARIES_MIRROR="https://npmmirror.com/mirrors/electron-builder-binaries/"
#    不设的话 install.js 会去连 GitHub Releases ⇒ 国内表现为**卡住不返回**。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# registry 是 pnpm/npm **自己**读取的配置（不走脚本透传），所以这行对两者都生效。
# 实测本机直连 registry.npmjs.org 被限速到 ~5 KiB/s（tarball 大面积 timeout），必须换源。
registry=https://registry.npmmirror.com/
